# Every ${ENV_VAR} that simmer.yaml references (SPEC.md §4). Names only —
# never commit values. An unresolvable reference is a fatal startup error, and
# all of them are reported at once.

# Postgres connection URL (§4.1 database.url).
DATABASE_URL=

# argon2id PHC string for the `cfapp` SMTP user (§5.3). Generate with argon2 or
# any PHC-compatible tool; it must begin "$argon2".
SIMMER_CFAPP_HASH=

# Bearer token for the admin API (§9.3). Logged as the actor `default` on every
# mutation. At least 16 random characters — §4.2 warns below that, because §9.3
# can pause a route or zero an allowance and either answers every affected
# message 451.
SIMMER_ADMIN_TOKEN=

# Optional named tokens (O-11, D-053), if `admin.tokens` is uncommented in
# simmer.yaml. Each one makes the §9.3 audit line name somebody rather than
# `default`. No two may share a secret.
# SIMMER_TOKEN_ONCALL=
# SIMMER_TOKEN_DEPLOY=

# Downstream credentials for the warming route (§4.1 routes[].downstream.auth).
POSTAL_USER=
POSTAL_PASS=

# Downstream credential for the overflow route.
SENDGRID_KEY=

# --- the acceptance stack only (docs/ACCEPTANCE.md) ------------------------
# Neither is needed for ordinary local development: docker-compose.yml defaults
# both, so `docker compose up -d` works without them. `tests/acceptance.rs` sets
# them itself on every compose invocation it makes, which it has to — see
# DECISIONS.md D-042.
#
# SIMMER_CONFIG           /app/simmer.acceptance.yaml
# SIMMER_WARMUP_STARTED   RFC 3339 instant; the harness moves it backwards to
#                         walk the ramp across simulated day boundaries
